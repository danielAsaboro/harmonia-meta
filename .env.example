# Copy to .env.local for local development. Never commit real values.

# Web + agent shared internal auth token (any long random string locally)
INTERNAL_API_TOKEN=local-dev-token
# Local scanner only. Cloud deployment discovers its managed private scanner URL.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
# Base64-encoded 32-byte key used only for local envelope encryption.
# Generate privately; never commit a real value.
HARMONIA_CONNECTION_ENVELOPE_KEY=

# Private FastAPI worker URL used for ADK-generated A2UI presentation plans.
AGENT_SERVICE_URL=http://localhost:8080

# Meta Model API key (https://dev.meta.ai/ -> API keys), sent as a Bearer token.
# Used by the web service (contextual answers, production planning) and the agent
# media calls (Muse Voice Transcribe, Muse Image).
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
TRANSCRIBER_MODEL_ID=muse-voice-transcribe-1.0
IMAGE_MODEL_ID=muse-image-1.0

# Google Cloud project used by the emulators and deployment scripts
GOOGLE_CLOUD_PROJECT=harmonia-local
PUBSUB_STAGE_TOPIC=harmonia-stages
PUBSUB_PRODUCTION_TOPIC=harmonia-production
PUBSUB_DATA_TOPIC=harmonia-data-work

# Model-cost guardrails and immutable pricing catalog version
MODEL_PRICING_VERSION=2026-11-03
# Required. Harmonia has no in-process agent runtime or runtime fallback.
AGENT_ENGINE_RESOURCE=
MEMORY_BANK_ENABLED=true
# May reuse AGENT_ENGINE_RESOURCE or point at a dedicated Memory Bank reasoning engine.
MEMORY_BANK_RESOURCE=
GENERATIVE_MEDIA_ENABLED=false
ALLOW_GLOBAL_LYRIA=false
VERTEX_MEDIA_LOCATION=us-central1
LYRIA_3_CLIP_COST_USD=
LYRIA_3_PRO_COST_USD=
VEO_3_1_COST_PER_SECOND_USD=
DEFAULT_JOB_BUDGET_USD=5.00
DEFAULT_JOB_APPROVAL_THRESHOLD_USD=0.25
DEFAULT_WORKSPACE_BUDGET_USD=100.00
IMAGE_MAX_COST_USD=0.500000

# Metadata-only OpenTelemetry. Content capture remains disabled.
HARMONIA_TELEMETRY_ENABLED=0
HARMONIA_TELEMETRY_SAMPLE_RATE=1.0
OTEL_SERVICE_NAME=harmonia-agent
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Server clock controls (for replayable/fast-forwarded workflows)
# Set this to a UTC timestamp to anchor all server time calculations.
HARMONIA_TIME_ORIGIN=
# Optional speed multiplier (1 = real-time, >1 = fast-forward).
HARMONIA_TIME_SPEED=1

# Per-role cognitive routing (no implicit model fallback)
COORDINATOR_MODEL_ID=muse-spark-1.3
STRATEGIST_MODEL_ID=muse-spark-1.3
ANALYST_MODEL_ID=muse-spark-1.3
COPYWRITER_MODEL_ID=muse-spark-1.3
EDITOR_MODEL_ID=muse-spark-1.3
PLANNER_MODEL_ID=muse-spark-1.3
PRESENTER_MODEL_ID=muse-spark-1.3

# --- Agent worker (agent/.env or exported env) ---

# Base URL of the web service the worker calls back into
WEB_INTERNAL_URL=http://localhost:3000

# Optional YouTube Data API key for richer ingest metadata.
YOUTUBE_API_KEY=

# Binary asset storage (generated images, rendered clips). infra/setup.sh
# provisions PROJECT_ID-harmonia-assets and deploy.sh uses it by default.
# Locally leave this empty to use .data/artifacts/.
GCS_BUCKET=

# Exact browser origins allowed to create attachment upload sessions.
# Comma-separated; production should include the public domain and Cloud Run URL.
ATTACHMENT_ALLOWED_ORIGINS=

# Governed resident autonomy schedules are opt-in. Keep disabled for local work
# and replay development; enabling provisions authenticated Scheduler wakes.
HARMONIA_ENABLE_RESIDENT_AUTONOMY=0
HARMONIA_WORKSPACE_TIMEZONE=Etc/UTC

# --- Social platform connections (Settings > Connected accounts shows live status) ---
# Each platform publishes only through its OFFICIAL API. Status surfaces in the
# dashboard reflect which of these are actually configured server-side.

# Google Identity Platform web application (Google provider enabled)
# Local development only: bypass Firebase sign-in with a deterministic
# emulator-backed user. The server refuses this flag in production.
HARMONIA_DEV_AUTH_BYPASS=0
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# TikTok Content Posting API: app credentials + user access token after OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API: Meta app + token from a linked Professional account
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIGURATION_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn: OAuth 2.0 app (w_member_social / w_organization_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Facebook Pages: Meta app + Page access token (pages_manage_posts)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_TOKEN=

# Google OAuth web client shared by YouTube and Google Calendar. Calendar asks
# only for calendar.app.created and writes to a dedicated Harmonia calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# X OAuth 2.0 user authorization for official API publishing/readback.
X_CLIENT_ID=
X_CLIENT_SECRET=
